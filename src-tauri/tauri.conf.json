{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Broadcast Playroom 3",
  "version": "3.0.0",
  "identifier": "com.broadcastplayroom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Broadcast Playroom 3",
        "width": 1280,
        "height": 820,
        "minWidth": 884,
        "minHeight": 720,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}