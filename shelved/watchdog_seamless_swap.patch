+    try:
+        if proc is not None and proc.poll() is None:
+            register_browser_process(proc)
+    except Exception:
+        pass
+    _log('UI watchdog: swap done in %.1fs (old window %s)' % (time.time() - t0, 'closed' if not u32.IsWindow(main_old) else 'STILL OPEN'))
+    return True
