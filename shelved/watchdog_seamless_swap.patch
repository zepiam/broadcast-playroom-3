+def _app_windows():
+    """Visible titled top-level windows of this app's browser: {hwnd: (title, showCmd, normal_rect)}."""
+    out = {}
+    if os.name != 'nt':
+        return out
+    try:
+        import ctypes
+        from ctypes import wintypes
+        u32 = ctypes.windll.user32
+        pids = {p.pid for p in _browser_processes()}
+        if not pids:
+            return out
+        WP = _wp_class()
+
+        @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
+        def cb(hwnd, _l):
+            pid = wintypes.DWORD()
+            u32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
+            if pid.value in pids and u32.IsWindowVisible(hwnd) and u32.GetWindowTextLengthW(hwnd) > 0:
+                buf = ctypes.create_unicode_buffer(256)
+                u32.GetWindowTextW(hwnd, buf, 256)
+                wp = WP()
+                wp.length = ctypes.sizeof(WP)
+                u32.GetWindowPlacement(hwnd, ctypes.byref(wp))
+                r = wp.rcNormalPosition
+                out[int(hwnd)] = (buf.value, int(wp.showCmd), (r.left, r.top, r.right, r.bottom))
+            return True
+        u32.EnumWindows(cb, 0)
+    except Exception:
+        pass
+    return out
+
+
+def _main_window_of(windows):
+    """Pick the main app window among the browser's windows (popouts are separate windows): the one whose
+    normal rect matches the placement the main page reported, else the only one, else the largest."""
+    if not windows:
+        return None
+    if len(windows) == 1:
+        return next(iter(windows))
+    geo = _state.get('window_geometry')
+    if geo:
+        x, y, w, h = geo
+        for hwnd, (_t, _c, (l, t, r, b)) in windows.items():
+            if abs(l - x) <= 12 and abs(t - y) <= 12 and abs((r - l) - w) <= 24 and abs((b - t) - h) <= 24:
+                return hwnd
+    return max(windows, key=lambda h: (windows[h][2][2] - windows[h][2][0]) * (windows[h][2][3] - windows[h][2][1]))
+
