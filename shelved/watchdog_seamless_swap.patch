+def _swap_window() -> bool:
+    """Replace a hung app window without a visible gap and without double chat/TTS:
+    open a new window in the running browser (kept minimized while it loads), wait until ITS page sends a
+    heartbeat, give it the old window's exact placement (minimized stays minimized), then close the old one.
+    The server lets only the newest page read chat, so the old page goes silent as soon as the new one polls.
+    Returns False (caller falls back to kill + relaunch) if the browser cannot open a working page in time."""
+    launch = _cfg.get('swap_launch')
+    if os.name != 'nt' or not callable(launch):
+        return False
+    import ctypes
+    from ctypes import wintypes
+    u32 = ctypes.windll.user32
+    old = _app_windows()
+    main_old = _main_window_of(old)
+    if not main_old:
+        return False
+    with _lock:
+        known_pages = set((_state.get('pages') or {}).keys())
+    t0 = time.time()
+    _log('UI watchdog: seamless swap - opening a replacement window in the background')
+    try:
+        proc = launch()
+    except Exception as error:
+        _log('UI watchdog: swap launch failed: %s' % error)
+        return False
+    SW_SHOWMINNOACTIVE, SW_SHOWNOACTIVATE, SW_SHOWMAXIMIZED, SW_SHOWMINIMIZED = 7, 4, 3, 2
+    new_hwnd = None
+    ready = False
+    while time.time() - t0 < SWAP_WAIT_SECONDS:
+        for hwnd in _app_windows():
+            if hwnd not in old:
+                if not u32.IsIconic(hwnd):
+                    u32.ShowWindow(hwnd, SW_SHOWMINNOACTIVE)     # keep it out of sight while it loads
+        with _lock:
+            fresh = [pid for pid, ts in (_state.get('pages') or {}).items() if pid not in known_pages and ts >= t0]
+        if fresh:
+            # the replacement is the new window titled like the app (not e.g. a "page unresponsive" dialog)
+            titled = [h for h, v in _app_windows().items() if h not in old and 'Broadcast Playroom' in v[0]]
+            if titled:
+                new_hwnd = titled[0]
+                ready = True
+                break
+        time.sleep(0.25)
+    if not ready:
+        _log('UI watchdog: swap - replacement window did not load in %ss; falling back to a full restart' % SWAP_WAIT_SECONDS)
+        return False
+    WP = _wp_class()
+    try:
+        _t, show_cmd, (l, t, r, b) = old[main_old]
+        wp = WP()
+        wp.length = ctypes.sizeof(WP)
+        u32.GetWindowPlacement(new_hwnd, ctypes.byref(wp))
+        wp.rcNormalPosition = wintypes.RECT(l, t, r, b)
+        if show_cmd == SW_SHOWMINIMIZED or u32.IsIconic(main_old):
+            wp.showCmd = SW_SHOWMINNOACTIVE                    # user had it minimized: stays minimized
+        elif show_cmd == SW_SHOWMAXIMIZED:
+            wp.showCmd = SW_SHOWMAXIMIZED
+        else:
+            wp.showCmd = SW_SHOWNOACTIVATE                     # appears exactly where the old one is
+        u32.SetWindowPlacement(new_hwnd, ctypes.byref(wp))
+    except Exception as error:
+        _log('UI watchdog: swap placement failed: %s' % error)
+    # close the old main window (a hung page may block closing: then end its old renderers and retry)
+    WM_CLOSE = 0x0010
+    u32.PostMessageW(main_old, WM_CLOSE, 0, 0)
+    for _ in range(12):
+        time.sleep(0.25)
+        if not u32.IsWindow(main_old):
+            break
+    if u32.IsWindow(main_old):
+        try:
+            for p in _browser_processes():
+                try:
+                    if '--type=renderer' in ' '.join(p.cmdline()) and p.create_time() < t0:
+                        p.kill()
+                except Exception:
+                    pass
+        except Exception:
+            pass
+        time.sleep(0.5)
+        u32.PostMessageW(main_old, WM_CLOSE, 0, 0)
+        for _ in range(12):
+            time.sleep(0.25)
+            if not u32.IsWindow(main_old):
+                break
